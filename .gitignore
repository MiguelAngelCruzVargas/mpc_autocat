# .NET / Visual Studio
plugin/**/bin/
plugin/**/obj/
*.user

# Python
mcp_server/__pycache__/
mcp_server/.venv/
mcp_server/*.egg-info/
mcp_server/.pytest_cache/

# Salida de pruebas contra AutoCAD real: los DWG y las capturas que dejan
# test_live.py y capture_viewport quedan en la raiz del repo. Son artefactos
# de una corrida, no del proyecto -- si alguno hay que versionarlo (un DWG de
# referencia, por ejemplo), va a examples/ y se agrega con `git add -f`.
/*.dwg
/*.bak
/*.dwl
/*.dwl2
scratch_*.png
# Las capturas de revision visual tambien: capture_viewport las deja en la
# raiz y son de una corrida, igual que los DWG de arriba.
/*.png
# Donde se archivan esos DWG, capturas y datos sueltos de pruebas viejas,
# para que la raiz quede limpia: planos/, capturas/, datos/.
/pruebas/

# Tablero en vivo de tools/coordinacion.py: qué sesión tiene qué archivo y
# los mensajes entre ellas. Es de esta máquina y de este momento.
/.claude/coordinacion/

# Log del motor de plot (lo deja el driver PNG/PDF al plotear).
plot.log
mcp_server/plot.log

# Log del lanzador silencioso (tools/lanzar_silencioso.bat): ahí va a parar
# lo que antes se veía en la consola negra, de una corrida de cada quien.
autocad-ia.log

agent/__pycache__/

# Bytecode de los scripts de tools/ (coordinacion.py, run_code_acceso.py)
tools/__pycache__/

# Lo que el agente deja para descargar desde el panel web (PDF, catalogo
# de conceptos, CSV): son de cada proyecto, no del repo.
/entregables/
dist/
