<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target: net48 cubre la "generación clásica" (~2019-2024, API .NET
         Framework sin cambios entre versiones); net8.0-windows cubre AutoCAD
         2025+ (Autodesk migró el runtime a .NET 8, mismo namespace/API para lo
         básico). `dotnet build` compila los dos DLLs de una — en la otra máquina
         se carga con NETLOAD el que corresponda a la versión real instalada. -->
    <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AutoCadMcpPlugin</AssemblyName>
    <RootNamespace>AutoCadMcpPlugin</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- Roslyn, para run_code: compila en memoria el código de la IA y da el
       modelo semántico que usa el filtro de seguridad. 4.8 todavía apunta a
       netstandard2.0, así que sirve para los dos targets. Sus dependencias
       (System.Collections.Immutable, System.Reflection.Metadata) se copian al
       lado del DLL y las encuentra ResolvePluginDependency. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>
  <!-- En net8 una librería NO copia sus dependencias NuGet a la salida (solo
       las anota en deps.json), y AutoCAD carga el plugin desde la carpeta del
       bundle: sin esto, Roslyn no estaría ahí y run_code fallaría en 2025+.
       Las DLL de AutoCAD no se copian igual: van con ExcludeAssets=runtime. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows' Or '$(TargetFramework)' == 'net10.0-windows'">
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- AutoCAD ~2019-2024 (.NET Framework 4.8) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- AcCoreMgd.dll, AcDbMgd.dll, AcMgd.dll de AutoCAD 2022, CopyLocal=false
         (AutoCAD las provee en runtime; misma generación de API que 2019-2024,
         pero conviene probar en la versión real antes de confiar del todo). -->
    <PackageReference Include="AutoCAD-2022.Net.Base" Version="1.0.0" ExcludeAssets="runtime" />
    <!-- System.Text.Json no viene con net48, hay que traerlo por NuGet. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- Application.DoEvents() para bombear mensajes durante el plot (ver
         PlotHelper.cs) — ya está cargada en el proceso de acad.exe, esto
         solo trae la referencia de compilación. -->
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- AutoCAD 2025+ (.NET 8) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="ModPlus.AutoCAD.API.2025" Version="3.0.0" ExcludeAssets="runtime" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <!-- System.Text.Json ya viene incluido en el runtime de .NET 8. -->
  </ItemGroup>

  <!-- AutoCAD 2027 (.NET 10): no hay paquete NuGet de la API, asi que se compila contra los
       DLL administrados de la propia instalacion (solo referencia, Private=false: AutoCAD los
       provee en runtime). Para compilar este target hace falta AutoCAD 2027 instalado, o
       AcadDir2027 apuntando a su carpeta. Sin el, `dotnet build -f net8.0-windows` sigue andando. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <AcadDir2027 Condition="'$(AcadDir2027)' == ''">C:\Program Files\Autodesk\AutoCAD 2027</AcadDir2027>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Reference Include="accoremgd"><HintPath>$(AcadDir2027)\accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acdbmgd"><HintPath>$(AcadDir2027)\acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acdbmgdbrep"><HintPath>$(AcadDir2027)\acdbmgdbrep.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acmgd"><HintPath>$(AcadDir2027)\acmgd.dll</HintPath><Private>false</Private></Reference>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

</Project>
